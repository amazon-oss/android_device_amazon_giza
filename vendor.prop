# Audio
ro.hardware.audio.primary=amazon_wrapper
ro.audiohal.has_get_capture_position=false

# Bluetooth
persist.bluetooth.bluetooth_audio_hal.disabled=true

# Connsys
persist.vendor.connsys.chipid=-1
service.wcn.driver.ready=no
mediatek.wlan.chip=CONSYS_MT8163
mediatek.wlan.module.postfix=_consys_mt8163
persist.vendor.connsys.patch.version=-1
persist.vendor.connsys.dynamic.dump=0
vendor.connsys.driver.ready=no
ro.vendor.wlan.gen=gen2

# Sensors
ro.hardware.sensors=amazon_wrapper
